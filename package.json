    "@types/three": "^0.176.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-from-string": "^3.0.1",
    "hast-util-select": "^6.0.4",
